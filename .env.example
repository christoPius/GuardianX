# Leave unset to run against the built-in mock data layer (lib/mock).
# Set this once the FastAPI backend is deployed to switch the whole app
# to real data — no component code needs to change.
NEXT_PUBLIC_API_BASE_URL=

# Authentication — required in production. The local development fallback is
# admin@nightguard.local / nightguard-demo so the login page works out of the box.
AUTH_SESSION_SECRET=
AUTH_USER_EMAIL=
AUTH_USER_PASSWORD=
AUTH_USER_NAME=
